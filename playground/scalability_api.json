
{

    "scalability": {

        "temporal_view": {

            "strategy": "zoom_in" | "clipping" | "smoothing", // default: zoom_in

            "zoom_in_options":{	// takes effect only when 'strategy' is 'zoom_in', if an attribute is not set explicitly by user, then there is a default value. 

                "modes": ["interactions", "values", "interactions-values"],	// can choose 1-3 options; default: all

                "visibility": "all-active" | "after-trigger" | "off", // default: all-active

                "trigger": {

                    "type": "interaction" | "time",	// default: interaction

                    "threshold": int, 	// interaction count or seconds depending on type; default (interaction): 50; default (time): 3600s

                    "auto_zoom": true | false,	// whether automatically shows zoomed-in view when the threshold is reached; default: false

                    "suggestion": true | false 		// takes effect when auto_zoom is false; whether to suggest switching to the zoomed-in view; default: false

                }

            },

            "clipping_options": {

                "trigger": {

                    "type": "on_interaction_over" | "on_time_over", // default:interaction

                	"threshold": int,  // default: width / k (constant)

                }

            },

            "smoothing_options": {

                // Optional; defaults to { type: "savgol", window_length: 9, polyorder: 2 }.
                // Each method.type is required; its other parameters are optional.
                // Distance parameters use data-domain units; there is no unit option.
                "method": {
                    "type": "savgol",
                    "window_length": number, // default: 9; total data-domain window width
                    "polyorder": int // default: 2; polynomial order
                } | {
                    "type": "gaussian",
                    "sigma": number, // default: 2; data-domain standard deviation
                    "truncate": number // default: 3; support radius = truncate * sigma
                } | {
                    "type": "bspline",
                    "degree": int, // default: 3; cubic spline
                    "smoothing_factor": number, // default: 0.5; normalized [0, 1], larger = smoother
                    "knot_spacing": number // default: 10; data-domain distance between interior knots
                },

                // Optional; defaults to { type: "interaction", threshold: 50 }.
                "trigger": {
                    "type": "interaction" | "time", // optional; default: interaction
                    "threshold": int // optional; default: 50 interactions or 3600 seconds
                }

            }

        },



        "aggregate_view": {

            "strategy": "zoom_in" | "clipping" | "smoothing",

            "zoom_in_options": {	// by interaction times only

                "trigger": {

                    "type": "on_interaction_over" | "on_time_over" | "on_range_over", 	// range (not from range slider, but statistic term `range`): max interaction times - min interaction times (in order to see the interaction times more clearly even when there is a really high value next to it. For example, option A: 100 interactions, option B: 3 interactions, option C: 2 interactions. By zooming in and focusing on the range 0-10, we can clearly see the difference between option C and B, otherwise they are both too small because there is a 100. )           

                   "threshold": int, 

                    "tool_visible_before_trigger": true | false,

                    "auto_zoom_on_trigger": true | false,	

                    "suggestion_on": true | false 	

                }

            },

            "clipping_options": {

                "trigger": {

                    "type": "on_interaction_over" | "on_time_over"                     

                	"threshold": int

                }

            },

            "smoothing_options": {

                // Optional; defaults to { type: "savgol", window_length: 9, polyorder: 2 }.
                // Each method.type is required; its other parameters are optional.
                // Distance parameters use data-domain units; there is no unit option.
                "method": {
                    "type": "savgol",
                    "window_length": number, // default: 9; total data-domain window width
                    "polyorder": int // default: 2; polynomial order
                } | {
                    "type": "gaussian",
                    "sigma": number, // default: 2; data-domain standard deviation
                    "truncate": number // default: 3; support radius = truncate * sigma
                } | {
                    "type": "bspline",
                    "degree": int, // default: 3; cubic spline
                    "smoothing_factor": number, // default: 0.5; normalized [0, 1], larger = smoother
                    "knot_spacing": number // default: 10; data-domain distance between interior knots
                },

                // Optional; defaults to { type: "interaction", threshold: 50 }.
                "trigger": {
                    "type": "interaction" | "time", // optional; default: interaction
                    "threshold": int // optional; default: 50 interactions or 3600 seconds
                }

            },



            "window_options": {		// for value-wise scalability; I thinks it's applicable to any strategy, because it is not a matter of what to do when number of interaction increases, but a matter of what if thereare too many values (e.g. numerical 0-100, or 1000 options) but the space is limited. Then there should not be any loss of information but just to show it part by part. 

                "window_size": int, // number of items in a scrolled window view (items: checkbox options, inputbox items, slider values, etc.); by default = total number of items

                "window_start": int // default starting index of the window; default: 0 (the first item)

            }

        }

    }

}









